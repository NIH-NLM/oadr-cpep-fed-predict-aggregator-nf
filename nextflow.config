// 0: Manifest
manifest {
    name = 'lifebit-platform-federated-aggregation'
    description = 'Lifebit default Nextflow pipeline for federated analyses aggregation'
    mainScript = 'main.nf'
    version = "1.0.1"
}

// 1: Parameters 
includeConfig 'conf/customised_pipeline_resources.config'
includeConfig 'conf/containers/quay.config'

// NOTE: 
// Initialise the values of the params to the preferred default value or to false
params {
    raci_owner = "Lifebit"
    domain_keywords = "Omics"
    unique_identifier = "fag2025"

    // input options
    reference_data_bucket = "s3://lifebit-featured-datasets"
    bucket_pattern = "lifebit-featured-datasets"
    design_file = false

    // Federated aggregation (oadr-cpep) options
    phase                = "aggregate"   // "consensus" (Phase 1) or "aggregate" (Phase 2)
    aggregation          = "fedavg"      // fedavg (weighted by n_subjects) | median | mean
    min_sites            = false         // consensus threshold; false -> majority (n/2 + 1)
    oadr_cpep_container  = "ghcr.io/nih-nlm/oadr-cpep:0.1.0"  // shared with the site workflow

    // Report generation control
    generate_report = false  // Set to true to enable report generation
    
    // output options
    outdir = 'results'
    tracedir = "${params.outdir}/pipeline_info"
    report_dir = "/opt/bin"
    obtain_pipeline_metadata = false

    // when set to true, prints help and exits
    help = false

    // execution related defaults
    config = 'conf/executors/standard.config'
    echo = false
    executor = false

    // multi region support - these parameters expected from to be provided from cloudos for system tools
    lifebit_platform_deployment   = "cloudos.lifebit.ai"
    lifebit_platform_cloud_region = "eu-west-1" // for interpreting bucket path and container region
    lifebit_platform_executor     = "local"
    container_region              = params.lifebit_platform_cloud_region // only required incase of cloud provider container registry ecr/acr/gcr
}

// 2: Profiles
includeConfig 'conf/cloud-provider.config'
profiles {
    standard { includeConfig params.config }
    awsbatch { includeConfig 'conf/executors/awsbatch.config' }
    azurebatch { includeConfig 'conf/executors/azurebatch.config' }
    local { includeConfig 'conf/executors/local.config' }
    docker { docker.enabled = true }
    test_ci_input { includeConfig 'conf/tests/ci/test_ci_input.config' }
    singularity { includeConfig 'conf/executors/singularity.config' }
    dockerhub { includeConfig 'conf/containers/dockerhub.config' }
    quay { includeConfig 'conf/containers/quay.config' }
    ecr { includeConfig 'conf/containers/ecr.config' }
}

// 3: Process
includeConfig 'conf/data/data.config' // Loads in data
includeConfig 'conf/resources.config' // Loads in resources

process {
    container = params.report_container

    withLabel: report {
        container = params.report_container
    }

    withLabel: oadr_cpep {
        container = params.oadr_cpep_container
    }
}

// 4: Executor
// Do not remove this section! Required for running with different executors using --executor parameter
executor {
    name = params.executor
    queueSize = params.queueSize
}

// 5. Nextflow Extras
// Nextflow timeline, report and trace reports - DISABLED
timeline {
    enabled = false
    file = "${params.tracedir}/execution_timeline.html"
}
report {
    enabled = false
    file = "${params.tracedir}/execution_report.html"
}
trace {
    enabled = false
    overwrite = true
    fields = 'task_id,native_id,process,name,tag,status,exit,cpus,%cpu,memory,%mem,rss,vmem,peak_rss,peak_rss,container'
    file = "${params.tracedir}/execution_trace.txt"
}
