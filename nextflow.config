params {
    // Inputs — pass the per-site files EITHER as a samplesheet OR a comma-separated list
    sheet    = null   // a CSV with a `file` column, one path per row (best for Lifebit)
    vectors  = null   // aggregate.nf : per-site coefficient-vector CSVs + RF .pkl forests (comma-separated)
    features = null   // consensus.nf : per-site *_selected_features.csv (comma-separated)

    // Aggregation
    aggregation = "fedavg"     // fedavg (weighted by n_subjects) | median | mean
    // (panel + feature source are derived from the input files, never mixed)

    // Output — publishDir writes to results/; not a user-facing knob
    publish_mode = "copy"

    // Shared container — the current published oadr-cpep package image
    // (built & published by the oadr-cpep repo; this workflow only references it)
    container = "ghcr.io/nih-nlm/oadr-cpep:latest"
}

docker {
    enabled    = true
    runOptions = '--platform linux/amd64 --pull always'   // always use the current published image
}

profiles {
    // Local test on a Mac: no container — run the `oadr-cpep` CLI from your conda env.
    //   conda env create -f environment.yml && conda activate oadr-cpep-nf
    //   nextflow run aggregate.nf -profile local --vectors 'a_vector.csv,b_vector.csv'
    local { docker.enabled = false }
}

process {
    withLabel: oadr_cpep {
        container        = params.container
        containerOptions = '--entrypoint ""'   // clear the micromamba entrypoint so `oadr-cpep` runs
    }
}
