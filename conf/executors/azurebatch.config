params {
    // check available instances here: https://azure.microsoft.com/en-gb/pricing/details/batch/
    autopool_instance_type_micro = 'Standard_F2s_v2'
    autopool_instance_type_small = 'Standard_F2s_v2'
    autopool_instance_type_medium = 'Standard_F4s_v2'
    autopool_instance_type_large = 'Standard_D8a_v4'
    autopool_instance_type_xlarge = 'Standard_E16a_v4'
    autopool_auto_scale = true
    autopool_vm_count = 1
    autopool_max_vm_count = 50
    autopool_disk_size = '500 GB'
    spot = true
    deletePoolsOnCompletion = true
    privileged = true
    copyToolInstallMode = 'task'
    //or 'node"

    // The increased resources strategy won't work on Azure, as the instances are fixed on resources
    errorStrategy = 'terminate'
}
azure {
    batch {
        copyToolInstallMode = params.copyToolInstallMode
        deletePoolsOnCompletion = params.deletePoolsOnCompletion
        pools {
            fagg_micro_pool {
                autoScale = params.autopool_auto_scale
                vmType = params.autopool_instance_type_micro
                vmCount = params.autopool_vm_count
                maxVmCount = params.autopool_max_vm_count
                diskSize = params.autopool_disk_size
                spot = params.spot
                privileged = params.privileged
            }
            fagg_small_pool {
                autoScale = params.autopool_auto_scale
                vmType = params.autopool_instance_type_small
                vmCount = params.autopool_vm_count
                maxVmCount = params.autopool_max_vm_count
                diskSize = params.autopool_disk_size
                spot = params.spot
                privileged = params.privileged
            }
            fagg_medium_pool {
                autoScale = params.autopool_auto_scale
                vmType = params.autopool_instance_type_medium
                vmCount = params.autopool_vm_count
                maxVmCount = params.autopool_max_vm_count
                diskSize = params.autopool_disk_size
                spot = params.spot
                privileged = params.privileged
            }
            fagg_large_pool {
                autoScale = params.autopool_auto_scale
                vmType = params.autopool_instance_type_large
                vmCount = params.autopool_vm_count
                maxVmCount = params.autopool_max_vm_count
                diskSize = params.autopool_disk_size
                spot = params.spot
                privileged = params.privileged
            }
            fagg_xlarge_pool {
                autoScale = params.autopool_auto_scale
                vmType = params.autopool_instance_type_xlarge
                vmCount = params.autopool_vm_count
                maxVmCount = params.autopool_max_vm_count
                diskSize = params.autopool_disk_size
                spot = params.spot
                privileged = params.privileged
            }
        }
    }
}
process {
    withLabel: process_micro {
        queue = 'fagg_micro_pool'
    }
    withLabel: process_small {
        queue = 'fagg_small_pool'
    }
    withLabel: process_medium {
        queue = 'fagg_medium_pool'
    }
    withLabel: process_large {
        queue = 'fagg_large_pool'
    }
    withLabel: process_xlarge {
        queue = 'fagg_xlarge_pool'
    }
}
